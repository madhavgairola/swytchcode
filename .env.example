# Server Configuration
PORT=3001

# Google Gemini API Key (Required for reasoning & autonomous planning)
GEMINI_API_KEY=

# Swytchcode Mode (sandbox | production)
SWYTCHCODE_MODE=sandbox

# Optional Live API Keys (If omitted, Swytchcode executes in authentic sandbox mode)
WEATHER_API_KEY=
RESEND_API_KEY=
NOTION_API_KEY=
